rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leaderboards: anyone can read; a signed-in (anonymous) player may write only their own entry.
    match /boards/{board}/scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && board.matches('^(daily|class-[A-Z0-9]{4,8})-[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'points', 'questions', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.points is int && request.resource.data.points >= 0 && request.resource.data.points <= 110
        && request.resource.data.questions is int && request.resource.data.questions >= 1 && request.resource.data.questions <= 500
        && request.resource.data.at == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
